<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>海底撈隱藏吃法 Bingo</title>
    <style>
        body { 
            font-family: 'Microsoft JhengHei', 'PingFang TC', sans-serif; 
            background-color: #fcf9f2; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            padding: 30px 15px; 
            color: #333;
            margin: 0;
        }
        h1 { 
            color: #c92a2a; 
            text-align: center; 
            margin-bottom: 5px;
            font-size: 2.2rem;
        }
        p.subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 1.1rem;
        }
        .bingo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            max-width: 1000px;
            width: 100%;
        }
        @media (min-width: 768px) {
            .bingo-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }
        .card {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 20px 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            text-align: center;
            cursor: pointer;
            position: relative;
            min-height: 140px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            border: 2px solid #eaeaea;
            transition: all 0.2s ease-in-out;
            user-select: none;
            overflow: hidden;
        }
        .card:hover { 
            transform: translateY(-3px); 
            border-color: #c92a2a; 
            box-shadow: 0 6px 15px rgba(201, 42, 42, 0.15);
        }
        .card-title { 
            font-size: 1.25rem; 
            font-weight: 900; 
            color: #c92a2a; 
            margin-bottom: 12px; 
            line-height: 1.3;
        }
        .card-desc { 
            font-size: 0.9rem; 
            color: #555; 
            line-height: 1.4;
        }
        
        .stamp {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-15deg) scale(0);
            border: 4px solid #d32f2f;
            color: #d32f2f;
            padding: 10px 15px;
            font-size: 1.1rem;
            font-weight: 900;
            border-radius: 8px;
            background-color: rgba(255, 255, 255, 0.95);
            pointer-events: none;
            box-shadow: 0 0 15px rgba(211, 47, 47, 0.3);
            text-align: center;
            white-space: nowrap;
            opacity: 0;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s;
            letter-spacing: 1px;
        }
        
        .stamped .stamp { 
            transform: translate(-50%, -50%) rotate(-15deg) scale(1);
            opacity: 1;
        }
        .stamped { 
            background-color: #fff5f5; 
            border-color: #ffc9c9; 
        }
        .stamped .card-title, .stamped .card-desc {
            opacity: 0.4;
        }
        
        .btn-reset {
            margin-top: 40px;
            padding: 10px 25px;
            background-color: #fff;
            border: 2px solid #ccc;
            border-radius: 30px;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.2s;
        }
        .btn-reset:hover {
            background-color: #f1f1f1;
            color: #333;
        }
    </style>
</head>
<body>
    <h1>🍲 海底撈隱藏吃法 Bingo 🍲</h1>
    <p class="subtitle">點擊圖卡即可押上完成的日期與時間！再點擊一次可取消。</p>
    
    <div class="bingo-grid" id="grid">
        <!-- 內容將由 JavaScript 動態填入 -->
    </div>
    
    <button class="btn-reset" onclick="resetAll()">重置所有進度</button>

    <script>
        const methods = [
            { title: "泰式冬蔭功湯底", desc: "海鮮醬、蠔油、芝麻油、蔥花、芹菜、香菜、蒜泥、小米辣、白糖與檸檬片" },
            { title: "壽喜燒湯底", desc: "海鮮醬、蠔油、陳醋、白糖、鹽和芹菜，鹹甜日式風味" },
            { title: "蝦滑牛肉響鈴卷", desc: "將響鈴卷攤平，包入肥牛與蝦滑，下鍋煮3~5分鐘" },
            { title: "豆皮鑲蝦滑", desc: "將適量蝦滑擠進豆皮或老油條中一起煮，吸滿湯汁" },
            { title: "番茄牛肉蓋飯", desc: "番茄湯底加雞蛋花，淋在白飯上並撒上牛肉粒、芝麻與蔥花" },
            { title: "川味口水魚", desc: "巴沙魚煮熟後，淋上特製麻辣醬汁" },
            { title: "川味口水雞", desc: "雞腿肉煮熟後，沾上特製開胃麻辣醬汁" },
            { title: "麻醬寬粉", desc: "清水煮熟寬粉，拌入麻醬、老抽、陳醋、蒜末與小米辣" },
            { title: "芋泥煉乳銀絲卷", desc: "芋頭煮軟壓泥拌入煉乳，塞入剪開的銀絲卷中" },
            { title: "炸甜撈麵", desc: "點撈麵備註「用炸的」，搭配紅糖漿，鹹甜酥脆" },
            { title: "🎊 自由發揮 🎊", desc: "發揮創意，研發出專屬你自己的獨門隱藏吃法！" },
            { title: "🎉 甜點達人 🎉", desc: "哈根達斯冰淇淋與水果自助吧，吃好吃滿！" }
        ];

        document.addEventListener('DOMContentLoaded', function() {
            const grid = document.getElementById('grid');

            methods.forEach((method, index) => {
                const card = document.createElement('div');
                card.className = 'card';
                card.id = 'card-' + index;
                card.innerHTML = `
                    <div class="card-title">${method.title}</div>
                    <div class="card-desc">${method.desc}</div>
                    <div class="stamp"></div>
                `;
                
                // 點擊卡片進行打卡或取消
                card.addEventListener('click', function() {
                    if (this.classList.contains('stamped')) {
                        this.classList.remove('stamped');
                        this.querySelector('.stamp').innerHTML = '';
                        localStorage.removeItem('bingo-haidilao-' + index);
                    } else {
                        const now = new Date();
                        const dateStr = now.getFullYear() + '.' + 
                                        String(now.getMonth()+1).padStart(2, '0') + '.' + 
                                        String(now.getDate()).padStart(2, '0');
                        const timeStr = String(now.getHours()).padStart(2, '0') + ':' + 
                                        String(now.getMinutes()).padStart(2, '0');
                        
                        const stampText = `達成<br>${dateStr} ${timeStr}`;
                        
                        this.classList.add('stamped');
                        this.querySelector('.stamp').innerHTML = stampText;
                        
                        localStorage.setItem('bingo-haidilao-' + index, stampText);
                    }
                });

                // 讀取之前的打卡紀錄
                const savedStamp = localStorage.getItem('bingo-haidilao-' + index);
                if (savedStamp) {
                    card.classList.add('stamped');
                    card.querySelector('.stamp').innerHTML = savedStamp;
                }

                grid.appendChild(card);
            });
        });

        // 重置所有進度
        function resetAll() {
            if(confirm('確定要清除所有打卡進度嗎？')) {
                document.querySelectorAll('.card').forEach((card, index) => {
                    card.classList.remove('stamped');
                    card.querySelector('.stamp').innerHTML = '';
                    localStorage.removeItem('bingo-haidilao-' + index);
                });
            }
        }
    </script>
</body>
</html>
